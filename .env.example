# Server-only. Never import into the client bundle. Copy to .env and fill in; .env is in .gitignore. Placeholders only below.
# The server does NOT read a .env file by itself: export these in your shell or set them in your host's dashboard (docs/DEPLOYMENT.md has the table).

PORT=3001
NODE_ENV=development
# The public address(es) of the site, comma separated, https in production. The ONLY origins the browser APIs and the WebSocket accept
# in production. Required when NODE_ENV=production. (CORS_ORIGIN is the older name and still works; PUBLIC_ORIGIN wins.)
PUBLIC_ORIGIN=
CORS_ORIGIN=http://localhost:5173
# Reverse proxies in front of the server (0 = none). Set 1 on Render, Railway, Fly or a Caddy/nginx in front, so limits see the real client address.
TRUST_PROXY=0
# Where the built client is (default: packages/client/dist). SERVE_CLIENT=0 runs the API and sockets only.
CLIENT_DIST=
SERVE_CLIENT=
# enforce | report-only | off. report-only is for debugging a blank page only.
CSP_MODE=enforce

# ---- abuse limits (defaults are fine for a small public server) ----
MAX_CONNECTIONS=400
MAX_CONNECTIONS_PER_IP=12
MAX_ROOMS=120
JOINS_PER_MINUTE_PER_IP=20
HTTP_REQUESTS_PER_MINUTE_PER_IP=600
SHUTDOWN_TIMEOUT_MS=10000

# ---- existing dev switches (ABILITY_LAB is ignored in production) ----
ABILITY_LAB=
HUNT_STAGE=
ESCAPE_STAGES=
GHOST_STAGES=

# ---- dev-only client flags (?ghost=N). REFUSED (the server will not start) when NODE_ENV=production and this is 1. ----
DEV_FLAGS=

# ---- sign-in ----
# off | google | dev. Default: google when GOOGLE_CLIENT_ID is set, otherwise off (guests only). dev is refused when NODE_ENV=production.
AUTH_MODE=
GOOGLE_CLIENT_ID=
# 32+ random characters, not a placeholder. Required in production when sign-in is on. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=3600

# ---- progress database (Node built-in node:sqlite, needs Node 22.5+ and a PERSISTENT DISK) ----
DATABASE_PATH=data/world-break.sqlite

# ---- OpenAI scenarios: NOT BUILT. Reserved names; nothing reads them yet. The key never goes to the client. ----
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SCENARIOS_ENABLED=0
AI_SCENARIO_TIMEOUT_MS=4000
AI_SCENARIO_CALLS_PER_HOUR=
AI_SCENARIO_CALLS_PER_DAY=
