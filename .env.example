# Server-only. Never import into the client bundle. Copy to .env and fill in; .env is in .gitignore. Placeholders only below.
# Every variable is described in docs/PROGRESSION.md (table) and docs/handoffs/P6.md.

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- existing dev switches ----
ABILITY_LAB=
HUNT_STAGE=
ESCAPE_STAGES=
GHOST_STAGES=

# ---- P6 C: dev-only client flags (?ghost=N). Ignored when NODE_ENV=production. ----
DEV_FLAGS=

# ---- P6 C: sign-in ----
# off | google | dev. Default: google when GOOGLE_CLIENT_ID is set, otherwise off (guests only). dev is refused when NODE_ENV=production.
AUTH_MODE=
GOOGLE_CLIENT_ID=
# 32+ random characters. Required in production when sign-in is on.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=3600

# ---- P6 C: progress database (Node built-in node:sqlite, needs Node 22.5+ and a persistent disk) ----
DATABASE_PATH=data/world-break.sqlite

# ---- P6 B (OpenAI scenarios): NOT BUILT in this milestone. Reserved names; nothing reads them yet. ----
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SCENARIOS_ENABLED=0
AI_SCENARIO_TIMEOUT_MS=4000
AI_SCENARIO_CALLS_PER_HOUR=
AI_SCENARIO_CALLS_PER_DAY=
